# LOAD LIBRARIES
library(SciViews)
library(ggplot2)
library(pander)
library(dplyr)
library(tidyverse)
library(data.table)
library(anytime)
library(ggthemes)
# LOAD UTILITARY FUNCTIONS IN SRC FOLDER
for(i in list.files("./src/", pattern = ".R")){
print(i)
source(paste0("./src/", i))
}
# SET DIRECTORIES
data_path_clean <- paste0("data/clean/") # Set path to Clean folder
data_path_raw   <- paste0("data/raw/")   # Set path to row folder
plot_path       <- paste0("plots/")      # Set path to plot folder
path_LWP        <- paste0(data_path_raw, "LWP/")
path_SWP        <- paste0(data_path_raw, "SWP/")
path_weight     <- paste0(data_path_raw, "weight/")
# OPTIONAL : define a custom theme
my_theme <- theme_classic() +
theme(
text            = element_text(size = 11),
axis.title      = element_text(size = 12),
axis.text       = element_text(size = 11),
axis.text.x     = element_text(size = 8, angle = 90, hjust = 1, vjust = 0.5),
plot.title      = element_text(size = 12, hjust = 0.5),
strip.background = element_rect(colour = "white", fill = "white"),
strip.text = element_text(size = 12), # Increase size and make bold
)
Plants_ID <- read.csv(paste0(data_path_clean, "Plants_ID.csv"))
pander(Plants_ID)
# Compile all PSY files into one dataframe
LWP_raw <- load_LWP(path = path_LWP
) %>%
na.omit()
# Change the PSY id by Plant_ID
LWP_raw <- left_join(LWP_raw,
Plants_ID[c("Plant_ID", "PSY")],
by = "PSY")
pander(head(LWP_raw))
ggplot(LWP_raw) +
geom_line(aes(x = DateTime, y = LWP)) +
facet_wrap(~Plant_ID) +
theme_few()
# Write to raw folder
write.csv(x = LWP_raw, file = paste0(data_path_raw, "LWP_raw.csv"), row.names = F)
# LOAD RAW LWP
LWP_raw <- read.csv(paste0(data_path_raw, "LWP_raw.csv")) %>%
mutate(DateTime = anytime(DateTime)) %>%
mutate(DateTime = as.POSIXct(DateTime, format = "%Y-%m-%d %H:%M:%S")) %>%
mutate(Plant_ID = as.factor(Plant_ID)) %>%
filter(LWP > -2) # Realistic values
################################################################################
# CLEANING MANNUALLY
LWP_clean1 <- LWP_raw %>%
filter(dT >= -1.5 & dT <= 0.5) %>%
filter(WetBulb > 0)
################################################################################
LWP_clean2 <- clean.LWP(LWP_data = LWP_clean1,
check.na     = T,
check.zero   = T,
check.cycles = T,
check.slope  = T,
check.level  = T,
nan.th       = 0.5,
zero.th      = 0.5,
cycle.alpha  = 0.5,
slope.th     = 0.00005,
level.alpha  = 2)
################################################################################
p_comp <- plot_timeseries(data = LWP_clean2
,x = "DateTime", y = "LWP"
,color = "Plant_ID"
,show.lines = F
) +
geom_line(data = LWP_raw, aes(x = DateTime, y = LWP), color = "red") +
geom_line(data = LWP_clean1, aes(x = DateTime, y = LWP), color = "orange") +
geom_line(data = LWP_clean2, aes(x = DateTime, y = LWP), color = "green") +
facet_wrap(~Plant_ID) +
ylab("Leaf Water Potantial [MPa]")
p_comp
ggsave(filename = paste0(plot_path, "LWP_comparison.png"), plot = p_comp
,width = 4, height = 3)
################################################################################
